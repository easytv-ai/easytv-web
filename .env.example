# Copy to .env.development (dev) or .env.production (build). Never commit .env.*
# 复制为 .env.development（开发）或 .env.production（构建）。.env.* 不入库。

# Site name shown in the UI and meta tags
NUXT_PUBLIC_SITE_NAME=EasyTV
# Backend (easytv-api) base URL. Local: http://localhost:8383
NUXT_PUBLIC_API_BASE_URL=http://localhost:8383
# Admin console (easytv-manage) URL. Admins see a "set up in admin console" link
# on the canvas when no models are enabled. Empty hides the link.
NUXT_PUBLIC_MANAGE_URL=http://localhost:3006
# Public URL of this site: canonical links, sitemap, Open Graph images
NUXT_PUBLIC_SITE_URL=http://localhost:3005
# Extra hostnames the server-side media proxy may fetch from (comma separated),
# e.g. your OSS / CDN domain. The API host above is always allowed.
# Needed when the bucket has no CORS headers (clip / split / extend filmstrip).
# Leave empty in the repo. Set this to your own bucket host when you deploy.
NUXT_PUBLIC_MEDIA_HOSTS=
# Contact address shown on the terms / privacy / AI-guidelines pages
NUXT_PUBLIC_CONTACT_EMAIL=
