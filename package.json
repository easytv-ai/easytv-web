{
  "name": "easytv-web",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "nuxt dev --dotenv .env.development",
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=4096 nuxt build --dotenv .env.production",
    "generate": "cross-env NODE_OPTIONS=--max-old-space-size=4096 nuxt generate --dotenv .env.production",
    "preview": "yarn run build && wrangler dev",
    "start": "cross-env NODE_ENV=production nuxt start",
    "deploy": "yarn run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "typecheck": "nuxt typecheck",
    "test": "vitest run"
  },
  "dependencies": {
    "@ffmpeg/core": "0.12.10",
    "@ffmpeg/ffmpeg": "0.12.15",
    "@ffmpeg/util": "0.12.2",
    "@fontsource-variable/geist": "^5.2.5",
    "@kangc/v-md-editor": "2.3.18",
    "@lobehub/icons-static-svg": "^1.91.0",
    "@nuxt/ui": "^4.7.1",
    "@nuxtjs/i18n": "^10.3.0",
    "@simplewebauthn/browser": "13",
    "@simplewebauthn/server": "13",
    "@tresjs/cientos": "^5.8.1",
    "@tresjs/core": "^5.8.3",
    "@tresjs/nuxt": "^5.6.3",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.2",
    "@vue/reactivity": "3.5.34",
    "@vueuse/core": "^14.3.0",
    "highlight.js": "^11.11.1",
    "nuxt": "4.4.5",
    "qrcode": "1.5.4",
    "tailwindcss": "^4.3.0",
    "three": "^0.186.0",
    "vue": "^3.5.34"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^25.8.0",
    "@types/three": "^0.184.1",
    "@vitalets/google-translate-api": "^9.2.1",
    "cross-env": "^10.1.0",
    "nitro-cloudflare-dev": "^0.2.2",
    "opencc-js": "^1.4.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0",
    "vue-tsc": "^3",
    "wrangler": "^4.128.0"
  }
}
